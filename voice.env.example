# ===== Голос (Day 4 + Day 5) — скопируйте нужные строки в .env =====
VOICE_ENABLED=true
VOICE_PRELOAD=true
VOICE_AUTO_LEAVE=true
VOICE_REPLY_WHEN_ALONE=true
VOICE_LOG_TRANSCRIPTS=true
VOICE_NAME_ALIASES=аура,ауры,ауре,ауру,аурой,аур,aura

# --- Распознавание речи (faster-whisper) ---
# tiny / base / small / medium / large-v3 / turbo  (small — хороший баланс)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=1

# --- Нарезка речи (Silero VAD) ---
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=400
VAD_MAX_SPEECH_S=15

# --- Озвучка (Silero TTS) ---
TTS_MODEL=v5_5_ru
# голоса: xenia, baya, kseniya (женские), aidar, eugene (мужские)
TTS_SPEAKER=xenia
TTS_DEVICE=auto
TTS_VOLUME=1.0

# --- Озвучка через Fish Speech (эмоциональный голос) ---
# silero — как раньше; fish — локальный сервер Fish Speech, при сбое фраза идёт через Silero.
TTS_ENGINE=silero
FISH_API_URL=http://127.0.0.1:8080
# Папка references/<id> на сервере Fish: образец голоса Ауры (sample.wav + sample.lab)
FISH_REFERENCE_ID=aura
FISH_TIMEOUT=20
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_REPETITION_PENALTY=1.2
FISH_RETRY_AFTER_S=30
