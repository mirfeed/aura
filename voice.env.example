# ===== Голос (Day 4 + Day 5) — скопируйте нужные строки в .env =====
VOICE_ENABLED=true
VOICE_PRELOAD=true
VOICE_AUTO_LEAVE=true
VOICE_REPLY_WHEN_ALONE=true
VOICE_LOG_TRANSCRIPTS=true
VOICE_NAME_ALIASES=аура,ауры,ауре,ауру,аурой,аур,aura

# --- Распознавание речи (faster-whisper) ---
# tiny / base / small / medium / large-v3 / turbo  (small — хороший баланс)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=1

# --- Нарезка речи (Silero VAD) ---
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=400
VAD_MAX_SPEECH_S=15

# --- Озвучка (Silero TTS) ---
TTS_MODEL=v5_5_ru
# голоса: xenia, baya, kseniya (женские), aidar, eugene (мужские)
TTS_SPEAKER=xenia
TTS_DEVICE=auto
TTS_VOLUME=1.0

# --- Озвучка через F5-TTS (живой голос из образца) ---
# silero — как раньше; f5 — сервер f5/f5_server.py, при сбое фраза идёт через Silero.
TTS_ENGINE=silero
F5_API_URL=http://127.0.0.1:8081
# Папка voices/<id> на сервере F5: образцы голоса Ауры
F5_REFERENCE_ID=aura
F5_TIMEOUT=20
F5_SPEED=1.0
F5_RETRY_AFTER_S=30
